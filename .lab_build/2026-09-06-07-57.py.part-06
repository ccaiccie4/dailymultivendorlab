atrix}</table></section><section id='lessons'><h2>Comprehensive source lessons</h2>{lessons}</section><section id='multi' class='card'><h2>Multivendor normalization and decision tree</h2><table><tr><th>Question</th><th>Normalizing principle</th><th>Do not assume</th></tr><tr><td>Did the protocol learn it?</td><td>Inspect protocol-specific LSDB/RIB/session/group/policy state.</td><td>Neighbor Up means route/service accepted.</td></tr><tr><td>Did it win?</td><td>Compare protocol candidate to global RIB preference/selection.</td><td>Protocol best automatically owns forwarding.</td></tr><tr><td>Can the next hop resolve?</td><td>Trace recursion until a connected adjacency/tunnel/label.</td><td>A visible next-hop address is reachable.</td></tr><tr><td>Did hardware/kernel program?</td><td>Inspect vendor-specific FIB/LFIB/ASIC/kernel state.</td><td>RIB entry proves packet forwarding.</td></tr><tr><td>Does policy alter state?</td><td>Verify exact policy object attachment and rule order.</td><td>Defined prefix/community/profile objects are automatically active.</td></tr><tr><td>Does Layer 2 protect correctly?</td><td>Distinguish LACP/LFM/UDLD/MLAG/VSF/MVRP/STP roles.</td><td>All link-safety features detect the same fault.</td></tr></table><h3>Underlay/overlay troubleshooting order</h3><ol><li>Physical/bidirectional L2 state</li><li>Underlay next-hop/locator reachability</li><li>Protocol/service control state</li><li>Policy import/export/transformation</li><li>RIB ownership and recursion</li><li>FIB/LFIB/adjacency/tunnel programming</li><li>Encapsulation/VNI/SID/label selection</li><li>MTU and packet evidence</li><li>Remote decapsulation/lookup</li><li>Return path and stateful policy</li></ol></section><section id='exam' class='card'><h2>Cumulative Exam — Exactly 50 Questions, Fixed Q1→Q50</h2><p>Q1–Q21 test today's new mechanisms. Q22–Q50 are newly written spaced-repetition scenarios with different reasoning angles and answer sets.</p><div id='qbox'></div><button onclick='gradeAll()'>Submit / Grade All 50</button><button onclick='resetExam()'>Reset Exam</button><div id='final'></div></section><section id='sources' class='card'><h2>Source index</h2><ol>{srcs}</ol></section><script id='history-json' type='application/json'>{html.escape(json.dumps(history),quote=False)}</script><script>const DATA={json.dumps(Q)};const checked={{}};function selected(id){{const e=document.querySelector(`input[name="q${{id}}"]:checked`);return e?Number(e.value):null}}function render(){{const b=document.getElementById('qbox');b.innerHTML='';DATA.forEach(q=>{{const d=document.createElement('div');d.className='q';d.innerHTML=`<h3>Q${{q.id}} · ${{q.type}} · ${{q.kind}} · ${{q.vendor}} · ${{q.domain}}</h3><p><b>Mechanism:</b> ${{q.mechanism_fingerprint}}</p><p>${{q.stem}}</p>${{q.choices.map((c,i)=>`<label><input type="radio" name="q${{q.id}}" value="${{i}}"> ${{String.fromCharCode(65+i)}}. ${{c}}</label>`).join('')}}<button onclick="checkQ(${{q.id}})">Check Answer</button><div id="f${{q.id}}" class="feedback"></div>`;b.appendChild(d)}})}}function checkQ(id){{const q=DATA[id-1],s=selected(id),f=document.getElementById('f'+id);f.style.display='block';checked[id]=true;if(s===null){{f.className='feedback bad';f.innerHTML='<b>Unanswered.</b>';return}}const ok=s===q.correct;f.className='feedback '+(ok?'good':'bad');const items=q.choices.map((c,i)=>`<li><b>${{String.fromCharCode(65+i)}}:</b> ${{i===q.correct?'Correct — '+q.rationale:'Incorrect — '+c+' conflicts with the '+q.mechanism_fingerprint+' mechanism described in the cited lesson; it operates at a different state, scope or dependency.'}}</li>`).join('');f.innerHTML=`<b>${{ok?'Correct':'Incorrect'}}</b><ul>${{items}}</ul><p><b>What you missed:</b> ${{ok?'Nothing on this item.':q.miss}}</p><p><b>Exact source/topic:</b> <a href="${{q.source}}">${{q.source}}</a></p>`}}function gradeAll(){{let c=0,a=0;const dom={{}},ven={{}};DATA.forEach(q=>{{const s=selected(q.id),ok=s===q.correct;if(s!==null)a++;if(ok)c++;[[dom,q.domain],[ven,q.vendor]].forEach(([m,k])=>{{m[k]=m[k]||[0,0];m[k][1]++;if(ok)m[k][0]++}})}});const p=Math.round(c/50*100),fmt=m=>Object.entries(m).map(([k,v])=>`${{k}}: ${{v[0]}}/${{v[1]}} (${{Math.round(v[0]/v[1]*100)}}%)`).join('<br>');document.getElementById('final').innerHTML=`<div class="card"><div class="score">${{c}}/50 — ${{p}}% — ${{p>=80?'PASS':'FAIL'}}</div><p>Answered ${{a}} · Unanswered ${{50-a}} · Checked ${{Object.keys(checked).length}} · Unchecked ${{50-Object.keys(checked).length}}</p><h3>Domain performance</h3>${{fmt(dom)}}<h3>Vendor performance</h3>${{fmt(ven)}}</div>`}}function resetExam(){{document.querySelectorAll('#qbox input').forEach(x=>x.checked=false);Object.keys(checked).forEach(k=>delete checked[k]);document.querySelectorAll('.feedback').forEach(x=>{{x.style.display='none';x.innerHTML=''}});document.getElementById('final').innerHTML=''}}render();</script></div></body></html>"""
OUT.write_text(DOC,encoding='utf-8')
text=OUT.read_text()
checks={'lessons':text.count("<article class='lesson'>"),'beginner_sections':text.count('Beginner foundation — terms you need before this lesson'),'questions':len(Q),'ordered':[q['id'] for q in Q]==list(range(1,51)),'question_fingerprints':len({q['fingerprint'] for q in Q}),'mechanisms':len({q['mechanism_fingerprint'] for q in Q}),'answer_positions':{chr(65+i):sum(q['correct']==i for q in Q) for i in range(4)},'no_shuffle':'shuffle(' not in text and 'Math.random' not in text,'no_generic_shells':all(s not in text for s in ['Which troubleshooting approach best matches this lesson?','Which observation should be checked first?','Which state boundary failed?','Verify the feature-specific state']),'compression_free':all(s not in text.lower() for s in ['atob(','gzip','base64']),'grading':'function gradeAll()' in text and 'function checkQ' in text,'history':'history-json' in text}
js=re.search(r'<script>const DATA=.*?</script>',text,re.S).group(0)[8:-9]
Path('/mnt/data/check_dmrl.js').write_text(js)
node=subprocess.run(['node','--check','/mnt/data/check_dmrl.js'],capture_output=True,text=True)
checks['js_syntax']=node.returncode==0
assert checks['lessons']==21 and checks['beginner_sections']==21 and checks['questions']==50 and checks['ordered'] and checks['question_fingerprints']==50 and checks['mechanisms']==50 and checks['no_shuffle'] and checks['no_generic_shells'] and checks['compression_free'] and checks['grading'] and checks['js_syntax']
print(OUT)
print(OUT.stat().st_size)
print(json.dumps(checks,indent=2))
